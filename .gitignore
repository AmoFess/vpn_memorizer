```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
*.class

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Build outputs
dist/
build/
target/
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
.mypy_cache/
.pytest_cache/

# System files
.DS_Store
Thumbs.db
```